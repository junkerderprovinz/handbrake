#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Runs the watch-folder daemon as abc, the PUID/PGID-remapped runtime user, so
# every converted file gets the right owner and the container UMASK.
# s6-setuidgid leaves the environment alone, so HOME and the XDG paths are set
# here; otherwise HandBrakeCLI writes its state next to a root-owned HOME it
# cannot use.
exec s6-setuidgid abc \
    env HOME=/config \
        XDG_CONFIG_HOME=/config/.config \
        XDG_CACHE_HOME=/config/.cache \
    /usr/local/bin/handbrake-watch.sh
