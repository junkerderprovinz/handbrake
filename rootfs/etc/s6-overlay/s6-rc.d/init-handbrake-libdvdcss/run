#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Opt-in CSS decryption for retail DVDs, off unless INSTALL_LIBDVDCSS=true.
# libdvdread parses a commercial disc's unencrypted IFO structure, but the
# payload needs libdvdcss, which this image does not ship and which is not in
# the Ubuntu archive.
#
# On request this downloads the release tarball from VideoLAN's own mirror,
# checks it against a checksum pinned here and compiles it on this machine,
# which is the difference between distributing a decryptor and enabling one.
# Whether using it is lawful depends on where you are, so nothing happens until
# the operator flips the switch.
#
# libdvd-pkg is not used: it fetches from code.videolan.org, which answers with
# a bot-protection page instead of the archive, so its checksum check fails.
# The release mirror is not affected.
#
# The build is cached under /config, so it runs once rather than on every start.
#
# No `set -e`: this oneshot runs before init-config-end, where a non-zero exit
# keeps the WebUI from ever coming up. Every step is checked by hand and every
# path ends in exit 0.

LIBDVDCSS_VERSION="1.5.0"
# sha256 of libdvdcss-1.5.0.tar.xz as published by VideoLAN next to the tarball.
# Pinned here because a checksum fetched from the server it guards proves
# nothing. Bump both values together when moving to a new release.
LIBDVDCSS_SHA256="529463e4d1befef82e5c6e470db7661a2db0343e092a2fb0d6c037cab8a5c399"
MIRROR="https://download.videolan.org/pub/videolan/libdvdcss/${LIBDVDCSS_VERSION}"
TARBALL="libdvdcss-${LIBDVDCSS_VERSION}.tar.xz"

log() { echo "[init-handbrake-libdvdcss] $*"; }

# Runs a command, prefixes its output into the container log and returns the
# command's own exit status, which `cmd | sed` would replace with sed's.
run_logged() {
    local out rc=0
    out="$(mktemp)"
    "$@" > "${out}" 2>&1 || rc=$?
    sed 's/^/[init-handbrake-libdvdcss] /' "${out}"
    rm -f "${out}"
    return "${rc}"
}

have_lib() { ldconfig -p 2>/dev/null | grep -q 'libdvdcss\.so\.2'; }

case "${INSTALL_LIBDVDCSS,,}" in
    true|yes|1|on) ;;
    *) exit 0 ;;
esac

if have_lib; then
    log "libdvdcss is already present, nothing to do"
    exit 0
fi

ARCH="$(dpkg --print-architecture 2>/dev/null || echo unknown)"
CACHE="/config/handbrake/libdvdcss/${ARCH}"
BUNDLE="${CACHE}/libdvdcss-${LIBDVDCSS_VERSION}.tar.gz"

if ! mkdir -p "${CACHE}" 2>/dev/null; then
    log "ERROR: cannot create ${CACHE}, continuing without libdvdcss"
    exit 0
fi

# A build from an earlier start needs no network at all.
if [ -f "${BUNDLE}" ]; then
    log "installing libdvdcss ${LIBDVDCSS_VERSION} from the cached build in ${CACHE}"
    if run_logged tar -xzf "${BUNDLE}" -C / && run_logged ldconfig && have_lib; then
        log "libdvdcss ${LIBDVDCSS_VERSION} is installed (from cache)"
        exit 0
    fi
    log "the cached build would not install, discarding it and building again"
    rm -f "${BUNDLE}"
fi

log "INSTALL_LIBDVDCSS is set and nothing is cached: building libdvdcss ${LIBDVDCSS_VERSION}"
log "this downloads the source and compiles it once, then caches the result in ${CACHE}"

export DEBIAN_FRONTEND=noninteractive
if ! run_logged timeout 300 apt-get update -qq; then
    log "ERROR: apt-get update failed, continuing without libdvdcss"
    exit 0
fi
if ! run_logged timeout 900 apt-get install -y --no-install-recommends \
        build-essential meson ninja-build pkg-config xz-utils; then
    log "ERROR: could not install the build tools, continuing without libdvdcss"
    exit 0
fi

WORK="$(mktemp -d)"
if [ -z "${WORK}" ] || [ ! -d "${WORK}" ]; then
    log "ERROR: could not create a work directory, continuing without libdvdcss"
    exit 0
fi
give_up() { log "$*"; rm -rf "${WORK}"; exit 0; }

if ! run_logged timeout 300 curl -fsSL --retry 3 --retry-delay 2 \
        -o "${WORK}/${TARBALL}" "${MIRROR}/${TARBALL}"; then
    give_up "ERROR: could not download ${MIRROR}/${TARBALL}, continuing without libdvdcss"
fi

GOT="$(sha256sum "${WORK}/${TARBALL}" 2>/dev/null | cut -d' ' -f1)"
if [ "${GOT}" != "${LIBDVDCSS_SHA256}" ]; then
    log "ERROR: checksum mismatch for ${TARBALL}"
    log "  expected ${LIBDVDCSS_SHA256}"
    log "  got      ${GOT:-nothing}"
    give_up "refusing to build from it, continuing without libdvdcss"
fi

if ! run_logged tar -xJf "${WORK}/${TARBALL}" -C "${WORK}"; then
    give_up "ERROR: could not unpack ${TARBALL}, continuing without libdvdcss"
fi

# Built into a staging tree so the same bytes can be cached and installed.
SRC="${WORK}/libdvdcss-${LIBDVDCSS_VERSION}"
if ! run_logged timeout 300 meson setup "${SRC}/_build" "${SRC}" \
        --prefix=/usr/local --buildtype=release; then
    give_up "ERROR: meson could not configure the build, continuing without libdvdcss"
fi
if ! run_logged timeout 900 ninja -C "${SRC}/_build"; then
    give_up "ERROR: the libdvdcss build failed, continuing without libdvdcss"
fi
if ! run_logged env DESTDIR="${WORK}/stage" ninja -C "${SRC}/_build" install; then
    give_up "ERROR: the build finished but would not install, continuing without libdvdcss"
fi

if run_logged tar -czf "${BUNDLE}" -C "${WORK}/stage" .; then
    chown -R "${PUID:-911}:${PGID:-911}" /config/handbrake/libdvdcss 2>/dev/null || true
else
    log "WARNING: could not cache the build; the next start will build it again"
fi

if ! run_logged cp -a "${WORK}/stage/." /; then
    give_up "ERROR: could not install the built library, continuing without libdvdcss"
fi
run_logged ldconfig || true
rm -rf "${WORK}"

if have_lib; then
    log "libdvdcss ${LIBDVDCSS_VERSION} is installed; encrypted DVDs can be scanned now"
else
    log "ERROR: the build finished but libdvdcss.so.2 is not loadable, continuing without it"
fi
exit 0
