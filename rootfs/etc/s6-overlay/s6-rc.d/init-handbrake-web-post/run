#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# The post-config half of the WEB_* mapping, ordered after init-handbrake and
# so after the base's init-selkies-config. The denied-path locations go into
# /etc/nginx/sites-available/default, which exists only once init-nginx wrote
# it, and init-selkies-config restores /etc/xdg/openbox/rc.xml on every start,
# which would drop an earlier terminal keybind.
#
# init-config-end/dependencies.d/init-handbrake-web-post makes the base wait for
# this oneshot before init-services brings svc-nginx up.
exec /usr/local/bin/handbrake-web.sh post-config
