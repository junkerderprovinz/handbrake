# syntax=docker/dockerfile:1.26
#
# Optional full-GPU variant. Build it yourself, it is not published.
#
#   1. Intel QSV: Ubuntu's handbrake-cli detects qsv_h264/qsv_h265 (they are
#      compiled in, see docs/handbrake-capabilities.md), but every real encode
#      fails at the muxer with "Application provided invalid, non monotonically
#      increasing dts to muxer" / "av_interleaved_write_frame failed with error
#      'Invalid argument'" (docs/hardware-encoding-intel.md). The bug is in
#      Ubuntu's packaged build, not in HandBrake or this container:
#      HandBrake/HandBrake#7962 reports the identical failure with Ubuntu 26.04
#      and handbrake-cli 1.11.0 from universe, and building the same tag from
#      source with --enable-qsv fixes it, at roughly 3x the speed of the CPU.
#
#   2. AMD VCE: Ubuntu does not build HandBrake with --enable-vce at all
#      (upstream enables it by default only for Windows hosts).
#
#   Both are fixed by rebuilding only HandBrakeCLI from source and dropping it
#   over the stock binary. The GTK GUI stays on the apt build; the GPU seam only
#   feeds HandBrakeCLI, which is what the watch-folder converter uses. NVENC
#   already works from the apt package (docs/hardware-encoding-nvidia.md) and
#   is enabled here too, so this binary can do everything the stock one can.
#
# AMD's AMF runtime (libamfrt64.so.1) is proprietary, not in Ubuntu and not ours
# to redistribute. Install amf-amdgpu-pro on the host and bind-mount the library
# in, see the README. Its last release supports RDNA1 and RDNA2 only, so on
# RDNA3/RDNA4 this variant does not help with VCE (QSV and NVENC are not
# affected).
#
# A full HandBrake contrib build, amd64 only: 30-60 minutes on 8 cores, under
# three minutes on 32.
#
#   docker build -f Dockerfile.gpu -t handbrake:gpu-full .
#
ARG BASE_IMAGE=ghcr.io/junkerderprovinz/handbrake:latest
ARG HANDBRAKE_TAG=1.11.2

# The builder is the same image as the runtime stage, so glibc and every system
# library the new binary links against are identical. It also carries the QSV
# runtime packages already, so the checks below need no extra apt work.
FROM ${BASE_IMAGE} AS builder
ARG HANDBRAKE_TAG
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN set -eux; \
    [ "$(dpkg --print-architecture)" = "amd64" ] \
        || { echo "ERROR: this variant is amd64 only (QSV and AMF are both x86-64 only)"; exit 1; }

# HandBrake's documented Ubuntu build dependencies, plus libva-dev, libvpl-dev
# and libdrm-dev for --enable-qsv, the amd64 build-depends of Ubuntu's own
# handbrake-cli (libhb/ports.c includes libdrm/drm.h directly).
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        autoconf automake build-essential cmake git libass-dev libbz2-dev \
        libfontconfig-dev libfreetype-dev libfribidi-dev libharfbuzz-dev \
        libjansson-dev liblzma-dev libmp3lame-dev libnuma-dev libogg-dev \
        libopus-dev libsamplerate0-dev libspeex-dev libtheora-dev libtool \
        libtool-bin libturbojpeg0-dev libvorbis-dev libx264-dev libxml2-dev \
        libvpx-dev m4 make meson nasm ninja-build patch pkg-config tar \
        zlib1g-dev curl libssl-dev clang python3 \
        libva-dev libvpl-dev libdrm-dev

RUN set -eux; \
    git clone --depth 1 --branch "${HANDBRAKE_TAG}" \
        https://github.com/HandBrake/HandBrake.git /src

WORKDIR /src

# --disable-gtk   CLI only; the GUI would double the build time for a binary
#                 this variant does not replace.
# --enable-qsv    the fix for the muxer bug above, from the same source tag as
#                 the build confirmed working upstream.
# --enable-vce    downloads the MIT-licensed AMF headers (AMF-headers-v1.5.0,
#                 sha256 checked by contrib/amf/module.defs) and builds the
#                 bundled FFmpeg with --enable-amf and the h264_amf, hevc_amf
#                 and av1_amf encoders. No proprietary binary is fetched.
# --enable-nvenc  already works from the apt package; kept so this binary can
#                 do everything the stock one can.
RUN set -eux; \
    ./configure --launch-jobs="$(nproc)" --launch --disable-gtk \
        --enable-qsv --enable-vce --enable-nvenc; \
    test -x /src/build/HandBrakeCLI

# Proves both hardware-only code paths are compiled in without owning either
# GPU. qsv_h264 is a compiled-in literal whatever the hardware probe says, and
# --help cannot answer this on a builder without a GPU
# (docs/hardware-encoding-intel.md section 1). The AMF component id libhb passes
# to check_component_available() is a wide-char literal that only exists when
# HB_PROJECT_FEATURE_VCE was on (libhb/vce_common.c); wchar_t is 4 bytes on
# Linux, hence `strings -e L`.
#
# `strings` writes to a file first because `strings | grep -q` fails under
# pipefail: grep exits on the first match, strings dies of SIGPIPE (141), and
# pipefail reports the pipeline as failed although grep found the string.
RUN set -eux; \
    strings -a /src/build/HandBrakeCLI > /tmp/hb-strings.txt; \
    grep -qx 'qsv_h264' /tmp/hb-strings.txt \
        || { echo "ERROR: the built HandBrakeCLI contains no qsv_h264 identifier"; exit 1; }; \
    strings -e L /src/build/HandBrakeCLI > /tmp/hb-strings-wide.txt; \
    grep -qx 'AMFVideoEncoderVCE_AVC' /tmp/hb-strings-wide.txt \
        || { echo "ERROR: the built HandBrakeCLI contains no AMF/VCE code path"; exit 1; }; \
    rm -f /tmp/hb-strings.txt /tmp/hb-strings-wide.txt; \
    echo "handbrake-gpu-full: qsv_h264 and AMF/VCE code paths confirmed in the binary"

# The runtime packages come from what the binary links against rather than a
# hand-kept list. Builder and runtime share a base, so the list holds there too.
RUN set -eux; \
    ldd /src/build/HandBrakeCLI | awk '/=> \//{print $3}' | sort -u \
      | xargs -r dpkg -S 2>/dev/null | cut -d: -f1 | sort -u > /src/runtime-deps.txt; \
    echo "handbrake-gpu-full: runtime packages ->"; cat /src/runtime-deps.txt

# The stock image plus one binary; none of the builder's toolchain and sources.
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY --from=builder /src/build/HandBrakeCLI /usr/local/bin/HandBrakeCLI
COPY --from=builder /src/runtime-deps.txt   /tmp/runtime-deps.txt

# mesa-va-drivers is the radeonsi VA-API driver. The stock image leaves it out,
# since every pull would pay for it; here it makes the vainfo section of
# /config/handbrake-gpu.log useful on AMD, and HandBrake's upcoming VA-API
# encoders need it.
#
# xargs -a passes the computed package list as arguments, which keeps an
# unquoted $(...) that shellcheck and hadolint would reject out of the RUN line.
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive xargs -a /tmp/runtime-deps.txt \
        apt-get install -y --no-install-recommends mesa-va-drivers vainfo; \
    rm -f /tmp/runtime-deps.txt; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# /usr/local/bin precedes /usr/bin on PATH, so the watch daemon's bare
# "HandBrakeCLI" resolves to this build; the check fails if that stops being
# true. The capability dumps are recorded again from the new binary so they
# describe this image.
RUN set -eux; \
    [ "$(command -v HandBrakeCLI)" = "/usr/local/bin/HandBrakeCLI" ] \
        || { echo "ERROR: $(command -v HandBrakeCLI) shadows the gpu-full build"; exit 1; }; \
    if ldd /usr/local/bin/HandBrakeCLI | grep 'not found'; then \
        echo "ERROR: the gpu-full build is missing shared libraries (listed above)"; exit 1; \
    fi; \
    HandBrakeCLI --version     > /usr/local/share/handbrake-version.txt 2>&1; \
    HandBrakeCLI --help        > /usr/local/share/handbrake-cli-help.txt 2>&1; \
    HandBrakeCLI --preset-list > /usr/local/share/handbrake-preset-list.txt 2>&1; \
    grep -q 'Very Fast 1080p30' /usr/local/share/handbrake-preset-list.txt \
        || { echo "ERROR: the default AUTOMATED_CONVERSION_PRESET is missing from this build"; exit 1; }; \
    echo "handbrake-gpu-full: $(head -n 1 /usr/local/share/handbrake-version.txt)"

LABEL org.opencontainers.image.title="handbrake-gpu-full"
LABEL org.opencontainers.image.description="HandBrake for Unraid with a source-built HandBrakeCLI (--enable-qsv --enable-vce --enable-nvenc), fixing the Ubuntu package's QSV muxing bug and adding AMD VCE via AMF. AMD VCE needs AMD's proprietary AMF runtime mounted in from the host."
